{
  "schemaVersion": 1,
  "id": "eqad_autologin",
  "version": "${version}",
  "name": "EQAD AutoLogin",
  "description": "为EQAD纯净服提供丝滑自动登录,支持多账号独立加密存储",
  "authors": ["495pygly"],
  "contact": {
    "homepage": "https://github.com/kerybotu/EQAD-AutoLogin",
    "sources": "https://github.com/kerybotu/EQAD-AutoLogin",
    "issues": "https://github.com/kerybotu/EQAD-AutoLogin/issues"
  },
  "license": "MIT",
  "icon": "assets/eqad_autologin/icon.png",
  "environment": "client",
  "accessWidener": "eqad_autologin.accesswidener",
  "entrypoints": {
    "client": ["com.pygly.eqadautologin.EQADAutoLoginClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=1.21.8 <1.22",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github": "https://github.com/kerybotu/EQAD-AutoLogin"
      },
      "badges": ["library"]
    }
  }
}
